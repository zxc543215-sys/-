# Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here

# Finnhub Financial Data API (optional, for enhanced news)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Market Data
NEXT_PUBLIC_USD_TWD_RATE=32.2

# Logging
LOG_LEVEL=info

# Cache TTL in seconds
CACHE_TTL_NEWS=300
CACHE_TTL_POLITICAL=300

# API Retry Configuration
API_MAX_RETRIES=3
API_RETRY_DELAY_MS=500
